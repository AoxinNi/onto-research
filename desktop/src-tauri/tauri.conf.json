{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ONTO Research",
  "version": "0.1.0",
  "identifier": "com.ontoresearch.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run assemble",
    "beforeBuildCommand": "npm run assemble"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ONTO Research",
    "category": "Productivity",
    "shortDescription": "Research workbench for sources, ontologies and papers",
    "longDescription": "Collect data sources, organise them into a typed research ontology with an AI agent, review every change, and write research reports.",
    "copyright": "© 2026 ONTO Research",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
