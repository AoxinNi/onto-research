{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The bundled workbench pages in the main window. Network, credentials and files stay on the Rust side; remote pages (the WeChat sign-in window) get no IPC at all.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-server-get",
    "allow-server-set",
    "allow-session-boot",
    "allow-api-request",
    "allow-download-file",
    "allow-confirm-dialog",
    "allow-open-external",
    "allow-socket-open",
    "allow-socket-send",
    "allow-socket-close",
    "allow-wechat-login"
  ]
}
